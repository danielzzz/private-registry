# Copy to .env before running the demo:
#   cp .env.example .env
#
# ADMIN_USER / ADMIN_PASSWORD create the bootstrap admin on first boot only
# (empty database). Changing them later does not update an existing admin.

ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Required: HMAC secret for admin session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Must match examples/local-demo/registry-config.yml
TOKEN_ISSUER=registry-auth
REGISTRY_SERVICE=registry

DATABASE_PATH=/data/registry-auth.db
TOKEN_CERT_PATH=/certs/token.crt
TOKEN_KEY_PATH=/certs/token.key
