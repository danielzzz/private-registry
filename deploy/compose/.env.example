# Copy to .env and adjust before `docker compose up`.
# cp .env.example .env

ADMIN_USER=admin
ADMIN_PASSWORD=changeme

SESSION_SECRET=change-me-to-a-long-random-string

TOKEN_ISSUER=registry-auth
REGISTRY_SERVICE=registry

DATABASE_PATH=/data/registry-auth.db
TOKEN_CERT_PATH=/certs/token.crt
TOKEN_KEY_PATH=/certs/token.key

# Host port for auth (must match realm in registry-config.yml)
AUTH_HOST_PORT=8080
